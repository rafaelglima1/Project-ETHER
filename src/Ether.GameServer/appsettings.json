{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3,
    "EnableDetailedErrors": false
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "ether:",
    "AbortOnConnectFail": true,
    "ConnectTimeoutMs": 5000
  },
  "Authentication": {
    "Issuer": "ether",
    "Audience": "ether-client",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30,
    "GameTokenLifetimeMinutes": 5
  },
  "WebSocket": {
    "Path": "/game",
    "HeartbeatIntervalSeconds": 20,
    "TimeoutSeconds": 60,
    "ReceiveBufferSize": 4096
  },
  "Character": {
    "StartingMapId": 1,
    "StartingX": 0,
    "StartingY": 0
  },
  "World": {
    "Width": 32,
    "Height": 32,
    "MaxMoveDistance": 12
  },
  "Combat": {
    "MinimumDamage": 1,
    "ResistanceCap": 0.9,
    "BasePower": 6,
    "PowerPerLevel": 2,
    "BaseArmor": 4,
    "ArmorPerLevel": 1.5,
    "BaseCriticalChance": 0.1,
    "CriticalMultiplier": 1.5,
    "MaxAttacksPerSecond": 4,
    "BaseMaxHealth": 100,
    "MaxHealthPerLevel": 0
  },
  "GameServer": {
    "TickRateHz": 20,
    "AiTickRateHz": 5,
    "InterestRadius": 30,
    "DisconnectGraceSeconds": 30,
    "HeartbeatIntervalSeconds": 20,
    "ConnectionTimeoutSeconds": 60,
    "MaxMessageSizeBytes": 16384,
    "MaxConnections": 1000,
    "MaxMovementCommandsPerSecond": 20,
    "MaxQueuedCommands": 256
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "MaxRetryCount": 3,
    "EnableDetailedErrors": false
  },
  "Redis": {
    "ConnectionString": "",
    "InstanceName": "ether:",
    "AbortOnConnectFail": true,
    "ConnectTimeoutMs": 5000
  },
  "Authentication": {
    "Issuer": "ether",
    "Audience": "ether-client",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30,
    "GameTokenLifetimeMinutes": 5
  },
  "WebSocket": {
    "Path": "/game",
    "HeartbeatIntervalSeconds": 20,
    "TimeoutSeconds": 60,
    "ReceiveBufferSize": 4096
  },
  "GameServer": {
    "TickRateHz": 20,
    "AiTickRateHz": 5,
    "InterestRadius": 30,
    "DisconnectGraceSeconds": 30
  },
  "Character": {
    "StartingMapId": 1,
    "StartingX": 0,
    "StartingY": 0
  },
  "World": {
    "Width": 32,
    "Height": 32,
    "MaxMoveDistance": 12
  }
}

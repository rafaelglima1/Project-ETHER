<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Project Ether — NuGet source configuration.
    The repository depends only on public packages, so machine-level feeds
    (e.g. private corporate Artifactory/Artifacts feeds) are cleared to keep
    restore reproducible and offline-independent of local credentials.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>

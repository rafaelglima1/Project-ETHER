{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-ether.invalid/content/schemas/loot-tables.schema.json",
  "title": "Creature loot tables",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "creatureId", "entries"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "creatureId": { "type": "string", "minLength": 1 },
      "entries": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["itemId", "chance", "minQuantity", "maxQuantity"],
          "properties": {
            "itemId": { "type": "string", "minLength": 1 },
            "chance": { "type": "number", "minimum": 0, "maximum": 1 },
            "minQuantity": { "type": "integer", "minimum": 1 },
            "maxQuantity": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-ether.invalid/content/schemas/abilities.schema.json",
  "title": "Ability definitions",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "damageType", "baseDamage", "powerScaling", "cooldownMilliseconds", "range"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "name": { "type": "string", "minLength": 1 },
      "damageType": { "enum": ["Physical", "Fire", "Ice", "Lightning", "Poison", "Arcane"] },
      "baseDamage": { "type": "number", "minimum": 0 },
      "powerScaling": { "type": "number", "minimum": 0 },
      "cooldownMilliseconds": { "type": "integer", "minimum": 0 },
      "range": { "type": "integer", "minimum": 1 }
    }
  }
}

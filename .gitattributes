# Project Ether — line ending and diff normalization.
# Repository stores text as LF; Windows-only script formats keep CRLF.

* text=auto eol=lf

*.sln text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary

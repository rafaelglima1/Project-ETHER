# Project Ether — local development environment.
# Copy this file to `.env` and adjust as needed. `.env` must never be committed.
# See .gitignore.

# PostgreSQL (development-only defaults)
POSTGRES_USER=ether
POSTGRES_PASSWORD=ether
POSTGRES_DB=ether

# ASP.NET Core environment: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Authentication signing key. Must be a strong secret in any non-local environment.
# The value below is a development placeholder only.
# In Production the app fails fast if this is missing, too short (<32) or still the placeholder.
AUTHENTICATION_SIGNING_KEY=development-only-signing-key-change-me

# Host port bindings (optional). Defaults bind to loopback so databases are never
# exposed publicly. Override on the Oracle runtime if a port is already in use.
POSTGRES_HOST_BIND=127.0.0.1
POSTGRES_HOST_PORT=5432
REDIS_HOST_BIND=127.0.0.1
REDIS_HOST_PORT=6379
API_HOST_BIND=127.0.0.1
API_HOST_PORT=8080
GAME_SERVER_HOST_BIND=127.0.0.1
GAME_SERVER_HOST_PORT=8081

